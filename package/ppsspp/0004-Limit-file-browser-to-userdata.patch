--- a/Common/File/PathBrowser.cpp
+++ b/Common/File/PathBrowser.cpp
@@ -217,8 +217,26 @@
 	return true;
 }
 
+static bool IsWithinRestrictedRoot(const Path &path, const Path &root) {
+	if (root.empty()) {
+		return true;
+	}
+	if (path.Type() != root.Type()) {
+		return false;
+	}
+	const std::string resolvedPath = File::ResolvePath(path.ToString());
+	const std::string resolvedRoot = File::ResolvePath(root.ToString());
+	if (!startsWith(resolvedPath, resolvedRoot)) {
+		return false;
+	}
+	if (resolvedPath.size() == resolvedRoot.size() || (!resolvedRoot.empty() && resolvedRoot.back() == '/')) {
+		return true;
+	}
+	return resolvedPath[resolvedRoot.size()] == '/';
+}
+
