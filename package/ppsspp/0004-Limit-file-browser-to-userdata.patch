From: Tspi <builds@example.invalid>
Subject: [PATCH] Limit PPSSPP file browsing to /userdata/ppsspp on Linux

Keep the embedded Linux game browser and saved location inside /userdata/ppsspp. Resolve
paths before checking the boundary so symlinks cannot escape the allowed tree. Preserve
the recent-games tab without saving its special path as the current directory.

---
--- a/UI/GameBrowser.cpp
+++ b/UI/GameBrowser.cpp
@@ -531,12 +531,27 @@
 	} else {
 		aliasDisplay_ = "ms:/";
 	}
+	Path startPath = path;
+#if PPSSPP_PLATFORM(LINUX) && !PPSSPP_PLATFORM(ANDROID) && !defined(PPSSPP_HOST_DEV)
+	// The recent-games tab uses a special path and must not become the saved directory.
+	if ((browseFlags_ & BrowseFlags::NAVIGATE) && startPath.ToString() == "!RECENT") {
+		startPath = Path("/userdata/ppsspp");
+	}
+	if (startPath.Type() == PathType::NATIVE && !startsWith(startPath.ToString(), "!")) {
+		// Keep the embedded Linux browser inside the user's data partition.
+		path_.RestrictToRoot(Path("/userdata/ppsspp"));
+	}
+#else
 	if (System_GetPropertyBool(SYSPROP_LIMITED_FILE_BROWSING) &&
-		(path.Type() == PathType::NATIVE || path.Type() == PathType::CONTENT_URI)) {
+		(startPath.Type() == PathType::NATIVE || startPath.Type() == PathType::CONTENT_URI)) {
 		// Note: We don't restrict if the path is HTTPS, otherwise remote disc streaming breaks!
 		path_.RestrictToRoot(GetSysDirectory(DIRECTORY_MEMSTICK_ROOT));
 	}
-	path_.SetPath(path);
+#endif
+	path_.SetPath(startPath);
+	if ((browseFlags_ & BrowseFlags::NAVIGATE) && path_.GetPath().Type() == PathType::NATIVE) {
+		g_Config.currentDirectory = path_.GetPath();
+	}
 	Refresh();
 }
 
