From 8e648994e87867327dfd31c446ed5663f487520a Mon Sep 17 00:00:00 2001
Subject: [PATCH] Make X11 support optional for the SDL EGL frontend

The target uses SDL's Wayland EGL handles and has no X11 development
libraries.
---
 CMakeLists.txt               |  8 +++++++-
 SDL/SDLGLGraphicsContext.cpp | 14 ++++++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -184,5 +184,6 @@ option(USING_EGL "Set to ON if target environment uses EGL" ${USING_EGL})
 option(USING_FBDEV "Set to ON if target environment uses fbdev (eg. Pandora)" ${USING_FBDEV})
 option(USING_GLES2 "Set to ON if target device uses OpenGL ES 2.0" ${USING_GLES2})
+option(USING_X11 "Set to ON if target environment uses X11" ON)
 option(USING_X11_VULKAN "Set to OFF if target environment doesn't use X11 for Vulkan" ON)
 option(USE_WAYLAND_WSI "Enable or disable Wayland WSI support for Vulkan" ON)
 option(USE_VULKAN_DISPLAY_KHR "Enable or disable full screen display of Vulkan" ${USE_VULKAN_DISPLAY_KHR})
@@ -366,5 +367,8 @@ if(USING_GLES2)
 	add_compile_definitions(USING_GLES2)
 endif()
+if(USING_X11)
+	add_compile_definitions(USING_X11)
+endif()
 if(MOBILE_DEVICE)
 	add_compile_definitions(MOBILE_DEVICE)
 endif()
@@ -979,7 +983,9 @@ if(TARGET Ext::GLEW)
 endif()
 
 if(USING_GLES2 OR (USING_EGL AND NOT USING_FBDEV))
-	find_package(X11)
+	if(USING_X11)
+		find_package(X11)
+	endif()
 endif()
 
 add_library(gason STATIC
diff --git a/SDL/SDLGLGraphicsContext.cpp b/SDL/SDLGLGraphicsContext.cpp
--- a/SDL/SDLGLGraphicsContext.cpp
+++ b/SDL/SDLGLGraphicsContext.cpp
@@ -94,16 +94,22 @@ static int8_t EGL_Open(SDL_Window *window) {
 	SDL_VERSION(&sysInfo.version);
 	if (!SDL_GetWindowWMInfo(window, &sysInfo)) {
 		fprintf(stderr, "ERROR: Unable to retrieve native window handle\n");
+#if defined(USING_X11)
 		g_Display = (EGLNativeDisplayType)XOpenDisplay(nullptr);
 		g_XDisplayOpen = g_Display != nullptr;
 		if (!g_XDisplayOpen)
 			EGL_ERROR("Unable to get display!", false);
 		g_Window = (EGLNativeWindowType)nullptr;
+#else
+		EGL_ERROR("Unable to retrieve native window handle.", false);
+#endif
 	} else {
 		switch (sysInfo.subsystem) {
+#if defined(SDL_VIDEO_DRIVER_X11)
 		case SDL_SYSWM_X11:
 			g_Display = (EGLNativeDisplayType)sysInfo.info.x11.display;
 			g_Window = (EGLNativeWindowType)sysInfo.info.x11.window;
 			break;
+#endif
 #if defined(SDL_VIDEO_DRIVER_DIRECTFB)
 		case SDL_SYSWM_DIRECTFB:
@@ -119,10 +125,14 @@ static int8_t EGL_Open(SDL_Window *window) {
 
 		if (!EGL_OpenInit()) {
 			// Let's try again with X11.
+#if defined(USING_X11)
 			g_Display = (EGLNativeDisplayType)XOpenDisplay(nullptr);
 			g_XDisplayOpen = g_Display != nullptr;
 			if (!g_XDisplayOpen)
 				EGL_ERROR("Unable to get display!", false);
 			g_Window = (EGLNativeWindowType)nullptr;
+#else
+			EGL_ERROR("Unable to initialize the native EGL display.", true);
+#endif
 		}
 	}
@@ -286,6 +296,6 @@ void EGL_Close() {
 	}
 	if (g_Display != nullptr) {
-#if !defined(USING_FBDEV)
+#if defined(USING_X11)
 		if (g_XDisplayOpen)
 			XCloseDisplay((Display *)g_Display);
 #endif
-- 
